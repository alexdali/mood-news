# Application
NODE_ENV=development
APP_URL=http://localhost:3000
COMPOSE_PROJECT_NAME=mood_news
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
LOG_LEVEL=info
DATABASE_PATH=./data/mood-news.db
DEFAULT_MOOD=neutral
NEWS_PAGE_SIZE=24

# Job protection and scheduling
CRON_SECRET=replace-with-a-long-random-value
INGEST_INTERVAL_MS=300000
REWRITE_INTERVAL_MS=60000
REWRITE_BATCH_SIZE=20
WORKER_RUN_ONCE=false

# Sources
BBC_ENABLED=true
BBC_RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.bbci.co.uk/news/technology/rss.xml,https://feeds.bbci.co.uk/news/business/rss.xml
GUARDIAN_ENABLED=true
GUARDIAN_API_KEY=
GUARDIAN_PAGE_SIZE=20

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Mood News Grid
AI_PRIMARY_MODEL=deepseek/deepseek-v4-flash-0731
AI_FALLBACK_MODEL=openai/gpt-5.6-luna
AI_REASONING_ENABLED=false
AI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=1800
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_PROVIDER_RETRIES=1
AI_RETRY_BASE_DELAY_MS=600
AI_PROMPT_VERSION=mood-v2-localized-facts
AI_REWRITE_LOCALES=en,ru
AI_TEMPERATURE=0.35
AI_ENABLE_RESPONSE_HEALING=false

# Safety / cost controls
MAX_ARTICLE_SUMMARY_CHARS=1800
MAX_REWRITE_LENGTH_RATIO=2.4
MIN_REWRITE_LENGTH_RATIO=0.45
MAX_DAILY_AI_COST_USD=2.00
