[Unit]
Description=Mood News Grid ingestion and AI worker
After=network-online.target mood-news-grid-web.service
Wants=network-online.target

[Service]
Type=simple
User=moodnews
Group=moodnews
WorkingDirectory=/opt/mood-news-grid
EnvironmentFile=/opt/mood-news-grid/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mood-news-grid/data /opt/mood-news-grid/reports

[Install]
WantedBy=multi-user.target
