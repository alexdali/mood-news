[Unit]
Description=Mood News Grid web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moodnews
Group=moodnews
WorkingDirectory=/opt/mood-news-grid
EnvironmentFile=/opt/mood-news-grid/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mood-news-grid/data /opt/mood-news-grid/reports

[Install]
WantedBy=multi-user.target
