{
  "name": "mood-news-grid",
  "version": "0.1.0",
  "private": true,
  "description": "Real news rewritten into selectable emotional modes with deterministic fact preservation.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:worker": "tsx watch scripts/worker.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['.next','coverage','playwright-report','test-results']) fs.rmSync(p,{recursive:true,force:true})\"",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed-sources.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:inspect": "tsx scripts/inspect-db.ts",
    "ingest": "tsx scripts/ingest-once.ts",
    "rewrite": "tsx scripts/rewrite-pending.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "evaluate:ai": "tsx scripts/benchmark-models.ts",
    "benchmark": "tsx scripts/benchmark-models.ts",
    "report": "tsx scripts/export-demo-report.ts",
    "verify:models": "tsx scripts/verify-models.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "export:data": "node scripts/export-demo-data.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm run check:imports && npm run check:syntax && npm run typecheck && npm run lint && npm run test",
    "sources:seed": "tsx scripts/seed-sources.ts",
    "check:imports": "node scripts/check-local-imports.mjs",
    "check:syntax": "node scripts/check-syntax.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "date-fns": "4.4.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "3.13.0",
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "2.16.1",
    "@vitest/ui": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "prettier": "^3.5.0"
  }
}
